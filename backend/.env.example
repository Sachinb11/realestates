# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bhagat_estates
# For production: mongodb+srv://username:password@cluster.mongodb.net/bhagat_estates

# JWT
JWT_SECRET=bhagat_estates_super_secret_jwt_key_2024_change_in_production
JWT_EXPIRE=7d

# Admin Credentials (change in production)
ADMIN_EMAIL=admin@bhagatestates.com
ADMIN_PASSWORD=Admin@123456

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact.bhagatestates@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=contact.bhagatestates@gmail.com
FROM_NAME=Bhagat Estates

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Frontend URL
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
